{
  "name": "@kud/glyphs",
  "version": "0.6.0",
  "type": "module",
  "description": "Multi-language source of truth for terminal glyphs — Nerd Font codepoints and unicode fallbacks, typed and escape-safe",
  "license": "MIT",
  "homepage": "https://kud.io/projects/glyphs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kud/glyphs.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "zsh",
    "glyphs.plugin.zsh",
    "glyphs.json",
    "colors.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run generate && tsup && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "node scripts/generate.mjs",
    "demo": "node scripts/subset-font.mjs && vite --config vite.demo.config.ts",
    "demo:build": "node scripts/subset-font.mjs && vite build --config vite.demo.config.ts",
    "demo:preview": "node scripts/subset-font.mjs && vite preview --config vite.demo.config.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "subset-font": "2.9.0",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
